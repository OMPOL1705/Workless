{
  "name": "workless-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && set ELECTRON_RENDERER_URL=http://localhost:5173 && electron .\"",
    "build": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^37.1.0",
    "vite": "^7.1.7",
    "wait-on": "^9.0.1"
  }
}
